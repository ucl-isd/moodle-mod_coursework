{{!
    @template mod_coursework/feedback/all

    Main layout template for the all feedback page.

    Context variables required for this template:
    * showpdf - Whether the PDF pane should be shown
    * feedback - HTML for the feedbacks

    Example context (json):
    {
        "showpdf": true,
        "feedback": ["<p>This is where the feedback from the previous marking stage would appear. The student did a good job overall.</p>"]
    }
}}
<h2>{{#str}} allfeedback, mod_coursework {{/str}}</h2>
<div {{#showpdf}} class="full-width" {{/showpdf}}>
    <div class="container-fluid">
        <div class="row">

            {{! Marking. }}
            <div class="col animate-enter">
                <div class="container">
                    {{! When not a PDF, show submissions metadata as header. }}
                    {{^showpdf}}
                        {{> mod_coursework/submissions/tr/submissions }}
                    {{/showpdf}}

                    <div class="d-flex">
                        <h3>{{#str}} marking, mod_coursework {{/str}}</h3>
                    </div>

                    {{! Feedback elements }}
                    <div id="mod_coursework-feedback-all">
                        {{#feedback}}
                            {{{.}}}
                        {{/feedback}}
                    </div>

                </div>
            </div>

            {{! Pdf. }}
            {{#showpdf}}
                <div class="col-md-6">
                    {{> mod_coursework/marking/pdf }}
                </div>
            {{/showpdf}}
        </div>
    </div>
</div>
{{#js}}
const wrapper = document.getElementById('review-source-wrapper');
if (wrapper) {
    wrapper.classList.remove('d-none');
    // Also remove the bullet point which shows as default list style type.
    wrapper.querySelectorAll('ul li').forEach(li => {
     li.style.listStyleType = 'none';
    });
}
{{/js}}