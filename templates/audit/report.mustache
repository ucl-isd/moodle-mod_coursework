{{!
    @template mod_coursework/audit/report

    Example context (json):
    {
        "course": "Course 101",
        "course_link": "https://moodle.localhost/course/view.php?id=123",
        "coursework": "Activity 1",
        "coursework_link": "https://moodle.localhost/mod/coursework/view.php?id=123",
        "assessors": "Assessor 1, Assessor 2",
        "moderators": "Moderator 1, Moderator 2"
    }
}}
<h3>{{#str}} summary, core {{/str}}</h3>
<table id="grading-audit-summary" class="table table-striped">
    <thead>
        <tr>
            <th>{{#str}} course, core {{/str}}</th>
            <th>{{#str}} courseworkname, mod_coursework {{/str}}</th>
            <th>{{#str}} assessors, mod_coursework {{/str}}</th>
            <th>{{#str}} moderators, mod_coursework {{/str}}</th>
            <th>{{#str}} submissions, mod_coursework {{/str}}</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>{{course}}</td>
            <td>{{coursework}}</td>
            <td>{{assessors}}</td>
            <td>{{moderators}}</td>
            <td>{{submissions}}</td>
        </tr>
    </tbody>
</table>

<h3>{{#str}} stats, mod_coursework {{/str}}</h3>
<table id="grading-audit-stats" class="table table-striped">
    <thead>
        <tr>
            <th>{{#str}} stats:mean, mod_coursework {{/str}}</th>
            <th>{{#str}} stats:median, mod_coursework {{/str}}</th>
            <th>{{#str}} stats:highest, mod_coursework {{/str}}</th>
            <th>{{#str}} stats:lowest, mod_coursework {{/str}}</th>
            <th>{{#str}} stats:sd, mod_coursework {{/str}}</th>
            <th>{{#str}} stats:plagiarismcount, mod_coursework {{/str}}</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>{{stats_mean}}</td>
            <td>{{stats_median}}</td>
            <td>{{stats_max}}</td>
            <td>{{stats_min}}</td>
            <td>{{stats_sd}}</td>
            <td>{{stats_flagged}}</td>
        </tr>
    </tbody>
</table>

<h3>{{#str}} gradingperassessor, mod_coursework {{/str}}</h3>
<table id="grading-audit-assessors" class="table table-striped">
    <thead>
        <tr>
            <th>{{#str}} assessor, mod_coursework {{/str}}</th>
            {{#assessor_headers}}
                <th>{{.}}</th>
            {{/assessor_headers}}
            <th>{{#str}} stats:mean, mod_coursework {{/str}}</th>
            <th>{{#str}} stats:median, mod_coursework {{/str}}</th>
            <th>{{#str}} stats:sd, mod_coursework {{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#assessors_data}}
            <tr>
                <td>{{name}}</td>
                {{#boundaries}}
                    <td>{{.}}</td>
                {{/boundaries}}
                <td>{{mean}}</td>
                <td>{{median}}</td>
                <td>{{sd}}</td>
            </tr>
        {{/assessors_data}}
    </tbody>
</table>

<h3>{{#str}} disagreementpermoderator, mod_coursework {{/str}}</h3>
<table id="grading-audit-moderation" class="table table-striped">
    <thead>
            <tr>
                <th>{{#str}} moderator, mod_coursework {{/str}}</th>
                {{#assessor_headers}}
                    <th>{{.}}</th>
                {{/assessor_headers}}
            </tr>
        </thead>
    <tbody>
        {{#moderators_data}}
            <tr>
                <td>{{name}}</td>
                {{#boundaries}}
                    <td>{{.}}</td>
                {{/boundaries}}
            </tr>
        {{/moderators_data}}
    </tbody>
</table>
