{{!
    @template mod_coursework/internal_comment

    Template for displaying internal marker comment.

    Example context (json):
    {
        "text": "Comment here",
    }
}}

<div class="coursework-feedback animate-enter">
    <h3>{{#str}} internalcomments, mod_coursework {{/str}}</h3>
    <div class="chat-bubble-bordered">
        {{{text}}}
    </div>
</div>